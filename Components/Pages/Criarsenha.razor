@page "/Criarsenha"

<div class="container">
    <h3>Criar Senha</h3>

    <input type="password" placeholder="Senha" @bind="Senha" />
    <input type="password" placeholder="Confirmar senha" @bind="Confirmar" />

    <button @onclick="Verificar">OK</button>

    <p id="msg">@Mensagem</p>
</div>

<style>
body {
    margin: 0;
    font-family: Arial;
    background-image: url("https://png.pngtree.com/thumb_back/fh260/background/20190221/ourmid/pngtree-summer-ice-cream-ice-cream-propaganda-image_11340.jpg");
    background-size: cover;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}
.container {
    text-align: center;
    padding: 20px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
}
input {
    display: block;
    margin: 10px auto;
    padding: 8px;
    width: 200px;
}
button {
    padding: 8px;
    width: 220px;
}
#msg {
    margin-top: 10px;
}
</style>

@code {
    private string Senha { get; set; } = string.Empty;
    private string Confirmar { get; set; } = string.Empty;
    private string Mensagem { get; set; } = string.Empty;

    private void Verificar()
    {
        if (!string.IsNullOrEmpty(Senha) && Senha == Confirmar)
        {
            Mensagem = "Senha correta";
        }
        else
        {
            Mensagem = "Senha incorreta";
        }
    }
}
