@page "/Criarsenha"

<div class="container">

    <h3>Criar Senha</h3>

    <input type="password"
           @bind="senha"
           placeholder="Senha" />

    <input type="password"
           @bind="confirmar"
           placeholder="Confirmar" />

    <button @onclick="Verificar">
        OK
    </button>

    <p>@mensagem</p>

</div>

@code {

    private string senha = "";
    private string confirmar = "";
    private string mensagem = "";

    private void Verificar()
    {
        if (senha == confirmar && senha != "")
        {
            mensagem = "Senha correta";
        }
        else
        {
            mensagem = "Erro na senha";
        }
    }

}