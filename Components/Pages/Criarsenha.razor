@page "/Criarsenha"


<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Senha</title>

<style>
body {
    font-family: Arial;
    text-align: center;

    background-image: url("https://www.magnific.com/br/fotos-vetores-gratis/fundo-sorvete");
    background-size: cover;
}

.container {
    margin-top: 150px;
    background: white;
    display: inline-block;
    padding: 20px;
}

input {
    display: block;
    margin: 10px auto;
    padding: 8px;
}

button {
    padding: 8px;
}

</style>
</head>

<body>

<div class="container">
    <h3>Criar Senha</h3>

    <input type="password" id="senha" placeholder="Senha">
    <input type="password" id="confirmar" placeholder="Confirmar">

    <button onclick="verificar()">OK</button>

    <p id="msg"></p>
</div>

<script>
function verificar() {
    let s = document.getElementById("senha").value;
    let c = document.getElementById("confirmar").value;
    let msg = document.getElementById("msg");

    if (s == c && s != "") {
        msg.innerHTML = "Senha correta";
    } else {
        msg.innerHTML = "Erro na senha";
    }
}
</script>

</body>
</html>
