@page "/Criarsenha"
@rendermode InteractiveServer

<div class="container">

    <h3>Criar Senha</h3>

    <input type="password" placeholder="Senha" @bind="Senha" />
    <input type="password" placeholder="Confirmar senha" @bind="Confirmar" />

    <button @onclick="Verificar">OK</button>

    <p id="msg">@Mensagem</p>

</div>

@code {
    private string Senha { get; set; } = string.Empty;
    private string Confirmar { get; set; } = string.Empty;
    private string Mensagem { get; set; } = string.Empty;

    private void Verificar()
    {
        if (!string.IsNullOrEmpty(Senha) && Senha == Confirmar)
        {
            Mensagem = "Senha correta";
        }
        else
        {
            Mensagem = "Senha incorreta";
        }
    }
}