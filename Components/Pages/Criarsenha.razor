@page "/Criarsenha"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models

@inject NavigationManager Navigation
@inject UsuarioDAO UsuarioDAO

<div class="pagina">

    <div class="container">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <h1>Criar uma senha</h1>

        <p class="descricao">
            Crie uma senha segura para proteger sua conta
        </p>

        <input type="password"
               placeholder="Digite sua senha"
               @bind="Senha" />

        <input type="password"
               placeholder="Confirme sua senha"
               @bind="ConfirmarSenha" />

        <button @onclick="Continuar">
            Continuar
        </button>

        <p class="senha-info">
            A senha deve conter pelo menos 8 caracteres.
        </p>

        @if (!string.IsNullOrWhiteSpace(Mensagem))
        {
            <p class="mensagem">@Mensagem</p>
        }

    </div>

</div>

@code {

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string Senha = "";
    private string ConfirmarSenha = "";
    private string Mensagem = "";

    private void Continuar()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            Mensagem = "E-mail não informado.";
            return;
        }

        if (Senha.Length < 8)
        {
            Mensagem = "A senha deve conter pelo menos 8 caracteres.";
            return;
        }

        if (Senha != ConfirmarSenha)
        {
            Mensagem = "As senhas não coincidem.";
            return;
        }

        try
        {
            var usuarioExistente = UsuarioDAO.BuscarPorEmail(Email);

            if (usuarioExistente != null)
            {
                Mensagem = "Este e-mail já está cadastrado.";
                return;
            }

            var usuario = new Usuario
            {
                Email = Email,
                Senha = Senha
            };

            UsuarioDAO.Inserir(usuario);

            Mensagem = "Conta criada com sucesso!";

            Navigation.NavigateTo("/Pagina_inicial");
        }
        catch (Exception ex)
        {
            Mensagem = "Erro ao criar conta: " + ex.Message;
        }
    }

}