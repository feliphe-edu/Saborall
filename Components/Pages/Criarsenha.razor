@page "/Criarsenha"

<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Senha</title>

<style>
body {
    margin: 0;
    font-family: Arial;

    background-image: url("https://png.pngtree.com/thumb_back/fh260/background/20190221/ourmid/pngtree-summer-ice-cream-ice-cream-propaganda-image_11340.jpg");
    background-size: cover;

    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

/* caixa transparente */
.container {
    text-align: center;
    padding: 20px;

    /* TRANSPARENTE */
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
}

input {
    display: block;
    margin: 10px auto;
    padding: 8px;
    width: 200px;
}

button {
    padding: 8px;
    width: 220px;
}

#msg {
    margin-top: 10px;
}
</style>
</head>

<body>

<div class="container">
    <h3>Criar Senha</h3>

    <input type="password" id="senha" placeholder="Senha">
    <input type="password" id="confirmar" placeholder="Confirmar senha">

    <button onclick="verificar()">OK</button>

    <p id="msg"></p>
</div>

<script>
function verificar() {
    let s = document.getElementById("senha").value;
    let c = document.getElementById("confirmar").value;

    if (s == c && s != "") {
        document.getElementById("msg").innerHTML = "Senha correta";
    } else {
        document.getElementById("msg").innerHTML = "Senha incorreta";
    }
}
</script>

</body>
</html>

