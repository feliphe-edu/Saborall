@page "/Estoque"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models
@using EstoqueModel = Saborall.Models.Estoque

@inject EstoqueDAO EstoqueDAO
@inject ProdutoDAO ProdutoDAO

<PageTitle>Estoque</PageTitle>

<div class="dashboard">

    <div class="sidebar">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <nav>
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas">Vendas</a>
            <a href="/Estoque" class="ativo">Estoque</a>
            <a href="/Produtos">Produtos</a>
            <a href="/Fornecedores">Fornecedores</a>
        </nav>

    </div>

    <div class="conteudo">

        <div class="pagina-estoque">

            <h1>Controle de Estoque</h1>

            @if (estoque == null || produtos == null)
            {
                <p>Carregando estoque...</p>
            }
            else
            {
                <div class="cards-resumo">

                    <div class="card">
                        <h3>Produtos em Estoque</h3>
                        <span>@QuantidadeTotal</span>
                    </div>

                    <div class="card">
                        <h3>Baixo Estoque</h3>
                        <span>@QuantidadeBaixoEstoque</span>
                    </div>

                    <div class="card">
                        <h3>Reposição Necessária</h3>
                        <span>@QuantidadeReposicao</span>
                    </div>

                </div>

                <table>

                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Quantidade</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in estoque)
                        {
                            var produto = produtos.FirstOrDefault(
                                p => p.IdProduto == item.IdProduto
                            );

                            if (produto != null)
                            {
                                <tr>
                                    <td>@produto.NomeProduto</td>

                                    <td>@produto.Categoria</td>

                                    <td>@item.QuantidadeDisponivel</td>

                                    <td>@ObterStatus(item.QuantidadeDisponivel)</td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>

@code {

    private List<EstoqueModel> estoque = new();
    private List<Produto> produtos = new();

    private int QuantidadeTotal =>
        estoque.Sum(e => e.QuantidadeDisponivel);

    private int QuantidadeBaixoEstoque =>
        estoque.Count(e =>
            e.QuantidadeDisponivel > 0 &&
            e.QuantidadeDisponivel <= 10);

    private int QuantidadeReposicao =>
        estoque.Count(e =>
            e.QuantidadeDisponivel <= 5);

    protected override void OnInitialized()
    {
        estoque = EstoqueDAO.Listar();
        produtos = ProdutoDAO.Listar();
    }

    private string ObterStatus(int quantidade)
    {
        if (quantidade <= 5)
            return "🔴 Repor";

        if (quantidade <= 10)
            return "🟡 Atenção";

        return "🟢 Normal";
    }
}