@page "/Fornecedores"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models

@inject FornecedorDAO FornecedorDAO

<PageTitle>Fornecedores</PageTitle>

<div class="dashboard">

    <div class="sidebar">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <nav>
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas">Vendas</a>
            <a href="/Estoque">Estoque</a>
            <a href="/Produtos">Produtos</a>
            <a href="/Fornecedores" class="ativo">Fornecedores</a>
        </nav>

    </div>

    <div class="conteudo">

        <div class="pagina-fornecedores">

            <h1>Fornecedores</h1>

            @if (fornecedores == null)
            {
                <p>Carregando fornecedores...</p>
            }
            else if (fornecedores.Count == 0)
            {
                <p>Nenhum fornecedor cadastrado.</p>
            }
            else
            {
                <div class="cards-fornecedores">

                    @foreach (var fornecedor in fornecedores)
                    {
                        <div class="fornecedor">

                            <h3>@fornecedor.NomeFantasia</h3>

                            <p>
                                <strong>Empresa:</strong>
                                @fornecedor.NomeEmpresa
                            </p>

                            <p>
                                <strong>Contato:</strong>
                                @fornecedor.Telefone
                            </p>

                            <p>
                                <strong>Email:</strong>
                                @fornecedor.Email
                            </p>

                            <p>
                                <strong>CNPJ:</strong>
                                @fornecedor.Cnpj
                            </p>

                            <p>
                                <strong>Endereço:</strong>
                                @fornecedor.Endereco
                            </p>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

@code {

    private List<Fornecedor> fornecedores = new();

    protected override void OnInitialized()
    {
        fornecedores = FornecedorDAO.Listar();
    }
}