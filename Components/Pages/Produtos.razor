@page "/Produtos"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models
@using EstoqueModel = Saborall.Models.Estoque

@inject ProdutoDAO ProdutoDAO
@inject FornecedorDAO FornecedorDAO
@inject EstoqueDAO EstoqueDAO

<PageTitle>Produtos</PageTitle>

<div class="dashboard">

    <div class="sidebar">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <nav>
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas">Vendas</a>
            <a href="/Estoque">Estoque</a>
            <a href="/Produtos" class="ativo">Produtos</a>
            <a href="/Fornecedores">Fornecedores</a>
        </nav>

    </div>


    <div class="conteudo">

        <div class="pagina-produtos">

            <h1>Produtos da Sorveteria</h1>


            <!-- FORMULÁRIO -->

            <div class="formulario-produto">

                <h2>
                    @(modoEdicao ? "Editar Produto" : "Cadastrar Produto")
                </h2>

                <div class="campos-produto">

                    <input type="text"
                           placeholder="Nome do produto"
                           @bind="novoProduto.NomeProduto" />

                    <input type="text"
                           placeholder="Categoria"
                           @bind="novoProduto.Categoria" />

                    <input type="number"
                           step="0.01"
                           min="0"
                           placeholder="Preço"
                           @bind="novoProduto.Preco" />

                    <select @bind="novoProduto.IdFornecedor">

                        <option value="">
                            Selecione o fornecedor
                        </option>

                        @foreach (var fornecedor in fornecedores)
                        {
                            <option value="@fornecedor.IdFornecedor">
                                @fornecedor.NomeFantasia
                            </option>
                        }

                    </select>

                </div>


                @if (modoEdicao)
                {
                    <div class="botoes-formulario">

                        <button class="botao-salvar"
                                @onclick="SalvarEdicao">
                            Salvar alteração
                        </button>

                        <button class="botao-cancelar"
                                @onclick="CancelarEdicao">
                            Cancelar
                        </button>

                    </div>
                }
                else
                {
                    <button class="botao-cadastrar"
                            @onclick="CadastrarProduto">
                        Cadastrar produto
                    </button>
                }


                @if (!string.IsNullOrWhiteSpace(Mensagem))
                {
                    <p class="mensagem">
                        @Mensagem
                    </p>
                }

            </div>


            <!-- LISTA DE PRODUTOS -->
            @if (produtos == null)
            {
                <p>Carregando produtos...</p>
            }
            else if (produtos.Count == 0)
            {
                <p>Nenhum produto cadastrado.</p>
            }
            else
            {
                <div class="grid-produtos">

                    @foreach (var produto in produtos)
                    {
                        <div class="produto-card">

                            <img src="@imagens[produto.NomeProduto.Trim().ToLower()]"
                                 alt="@produto.NomeProduto" />


                            <h3>
                                @produto.NomeProduto
                            </h3>


                            <p>
                                @produto.Categoria
                            </p>


                            <p>
                                R$ @produto.Preco.ToString("F2")
                            </p>


                            @if (produto.IdFornecedor.HasValue)
                            {
                                var fornecedor = fornecedores.FirstOrDefault(
                                    f => f.IdFornecedor == produto.IdFornecedor.Value
                                );

                                <p>
                                    <strong>Fornecedor:</strong>
                                    @(fornecedor?.NomeFantasia ?? "Não encontrado")
                                </p>
                            }
                            else
                            {
                                <p>
                                    <strong>Fornecedor:</strong>
                                    Não informado
                                </p>
                            }


                            @if (produtoParaExcluir == produto.IdProduto)
                            {
                                <div class="confirmacao-exclusao">

                                    <span>Excluir este produto?</span>

                                    <div class="botoes-confirmacao">

                                        <button class="botao-excluir-confirmar"
                                                @onclick="ConfirmarExclusao">
                                            Sim, excluir
                                        </button>

                                        <button class="botao-cancelar-exclusao"
                                                @onclick="CancelarExclusao">
                                            Cancelar
                                        </button>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="botoes-card">

                                    <button class="botao-editar"
                                            @onclick="() => EditarProduto(produto)">
                                        Editar
                                    </button>

                                    <button class="botao-excluir"
                                            @onclick="() => ExcluirProduto(produto.IdProduto)">
                                        Excluir
                                    </button>

                                </div>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>


@code {

    // IMAGENS DOS PRODUTOS

    private Dictionary<string, string> imagens = new()
    {
        { "chocolate supremo", "/Imagens/ChocolateSupremo.jpg" },
        { "morango cremoso", "/Imagens/MorangoCremoso.webp" },
        { "ninho com nutella", "/Imagens/Ninho com Nutella.jfif" },
        { "sorvete de jabuticaba", "/Imagens/Sorvete de Jabuticaba.png" },
        { "sorvete de queijo", "/Imagens/Sorvete de Queijo.png" },
        { "sorvete de pitaya", "/Imagens/sorvete-de-pitaya.jpg" }
    };


    // LISTAS

    private List<Produto> produtos = new();

    private List<Fornecedor> fornecedores = new();


    // PRODUTO DO FORMULÁRIO

    private Produto novoProduto = new();


    // CONTROLA SE ESTÁ EDITANDO

    private bool modoEdicao = false;


    // MENSAGEM

    private string Mensagem = "";


    // CONTROLA EXCLUSÃO

    private int produtoParaExcluir = 0;


    // CARREGAMENTO INICIAL

    protected override void OnInitialized()
    {
        CarregarDados();
    }


    // CARREGAR DADOS

    private void CarregarDados()
    {
        produtos = ProdutoDAO.Listar();
        fornecedores = FornecedorDAO.Listar();
    }


    // CADASTRAR PRODUTO

    private void CadastrarProduto()
    {
        Mensagem = "";

        if (string.IsNullOrWhiteSpace(novoProduto.NomeProduto))
        {
            Mensagem = "Digite o nome do produto.";
            return;
        }

        if (string.IsNullOrWhiteSpace(novoProduto.Categoria))
        {
            Mensagem = "Digite a categoria do produto.";
            return;
        }

        if (novoProduto.Preco <= 0)
        {
            Mensagem = "Digite um preço válido.";
            return;
        }

        try
        {
            int idProduto = ProdutoDAO.Inserir(novoProduto);

            var estoque = new EstoqueModel
            {
                IdProduto = idProduto,
                QuantidadeDisponivel = 0
            };

            EstoqueDAO.Inserir(estoque);

            Mensagem = "Produto cadastrado com sucesso!";

            novoProduto = new Produto();

            CarregarDados();
        }
        catch (Exception ex)
        {
            Mensagem = "Erro ao cadastrar produto: " + ex.Message;
        }
    }


    // EDITAR PRODUTO

    private void EditarProduto(Produto produto)
    {
        novoProduto = new Produto
        {
            IdProduto = produto.IdProduto,
            NomeProduto = produto.NomeProduto,
            Categoria = produto.Categoria,
            Preco = produto.Preco,
            IdFornecedor = produto.IdFornecedor
        };

        modoEdicao = true;

        Mensagem = "";
    }


    // SALVAR ALTERAÇÃO

    private void SalvarEdicao()
    {
        Mensagem = "";

        if (string.IsNullOrWhiteSpace(novoProduto.NomeProduto))
        {
            Mensagem = "Digite o nome do produto.";
            return;
        }

        if (string.IsNullOrWhiteSpace(novoProduto.Categoria))
        {
            Mensagem = "Digite a categoria do produto.";
            return;
        }

        if (novoProduto.Preco <= 0)
        {
            Mensagem = "Digite um preço válido.";
            return;
        }

        try
        {
            ProdutoDAO.Atualizar(novoProduto);

            Mensagem = "Produto atualizado com sucesso!";

            novoProduto = new Produto();

            modoEdicao = false;

            CarregarDados();
        }
        catch (Exception ex)
        {
            Mensagem = "Erro ao atualizar produto: " + ex.Message;
        }
    }


    // CANCELAR EDIÇÃO

    private void CancelarEdicao()
    {
        novoProduto = new Produto();

        modoEdicao = false;

        Mensagem = "";
    }


    // MOSTRAR CONFIRMAÇÃO DE EXCLUSÃO

    private void ExcluirProduto(int id)
    {
        Mensagem = "";

        produtoParaExcluir = id;
    }


    // CONFIRMAR EXCLUSÃO

    private void ConfirmarExclusao()
    {
        try
        {
            ProdutoDAO.Excluir(produtoParaExcluir);

            Mensagem = "Produto excluído com sucesso!";

            produtoParaExcluir = 0;

            CarregarDados();
        }
        catch (Exception ex)
        {
            Mensagem = "Não foi possível excluir o produto: " + ex.Message;

            produtoParaExcluir = 0;
        }
    }


    // CANCELAR EXCLUSÃO

    private void CancelarExclusao()
    {
        produtoParaExcluir = 0;
    }

}