@page "/Vendas"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models

@inject VendaDAO VendaDAO
@inject ProdutoDAO ProdutoDAO
@inject VendedorDAO VendedorDAO
@inject EstoqueDAO EstoqueDAO

<PageTitle>Vendas</PageTitle>

<div class="dashboard">

    <!-- SIDEBAR -->
    <div class="sidebar">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <nav>
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas" class="ativo">Vendas</a>
            <a href="/Estoque">Estoque</a>
            <a href="/Produtos">Produtos</a>
            <a href="/Fornecedores">Fornecedores</a>
        </nav>

    </div>


    <!-- CONTEÚDO -->
    <div class="conteudo">

        <h1>Registro de Vendas</h1>


        <!-- =========================================
             FORMULÁRIO DE NOVA VENDA
             ========================================= -->

        <div class="formulario-venda">

            <div class="titulo-formulario">

                <div>
                    <h2>Nova Venda</h2>

                    <p>
                        Preencha os dados abaixo para registrar uma nova venda.
                    </p>
                </div>

            </div>


            <!-- CAMPOS DA VENDA -->

            <div class="campos-venda">


                <!-- PRODUTO -->

                <div class="campo campo-produto">

                    <label for="produto">
                        Produto
                    </label>

                    <select id="produto"
                            @bind="produtoSelecionado">

                        <option value="0">
                            Selecione o produto
                        </option>

                        @foreach (var produto in produtos)
                        {
                            <option value="@produto.IdProduto">

                                @produto.NomeProduto -
                                R$ @produto.Preco.ToString("F2")

                            </option>
                        }

                    </select>

                </div>


                <!-- QUANTIDADE -->

                <div class="campo campo-quantidade">

                    <label for="quantidade">
                        Quantidade
                    </label>

                    <input id="quantidade"
                           type="number"
                           min="1"
                           @bind="quantidade" />

                </div>


                <!-- VENDEDOR -->

                <div class="campo">

                    <label for="vendedor">
                        Vendedor
                    </label>

                    <select id="vendedor"
                            @bind="vendedorSelecionado">

                        <option value="0">
                            Selecione o vendedor
                        </option>

                        @foreach (var vendedor in vendedores)
                        {
                            <option value="@vendedor.IdVendedor">
                                @vendedor.Nome
                            </option>
                        }

                    </select>

                </div>


                <!-- FORMA DE PAGAMENTO -->

                <div class="campo">

                    <label for="pagamento">
                        Forma de pagamento
                    </label>

                    <select id="pagamento"
                            @bind="formaPagamento">

                        <option value="PIX">
                            PIX
                        </option>

                        <option value="Cartão">
                            Cartão
                        </option>

                        <option value="Dinheiro">
                            Dinheiro
                        </option>

                    </select>

                </div>

            </div>


            <!-- =========================================
                 RESUMO DA VENDA
                 ========================================= -->

            <div class="resumo-venda">


                <!-- PRODUTO SELECIONADO -->

                <div class="resumo-info">

                    <span>
                        Produto selecionado
                    </span>

                    <strong>
                        @(ProdutoSelecionado?.NomeProduto
                            ?? "Nenhum produto selecionado")
                    </strong>

                </div>


                <!-- QUANTIDADE -->

                <div class="resumo-info">

                    <span>
                        Quantidade
                    </span>

                    <strong>
                        @quantidade
                    </strong>

                </div>


                <!-- PREÇO UNITÁRIO -->

                <div class="resumo-info">

                    <span>
                        Preço unitário
                    </span>

                    <strong>
                        R$ @(ProdutoSelecionado?.Preco.ToString("F2") ?? "0,00")
                    </strong>

                </div>


                <!-- TOTAL -->

                <div class="resumo-total">

                    <span>
                        Total da venda
                    </span>

                    <strong>
                        R$ @TotalVenda.ToString("F2")
                    </strong>

                </div>

            </div>


            <!-- =========================================
                 BOTÃO REGISTRAR VENDA
                 ========================================= -->

            <button class="botao-registrar"
                    @onclick="RegistrarVenda">

                <span class="icone-botao">
                    ✓
                </span>

                <span>
                    Registrar venda
                </span>

            </button>


            <!-- =========================================
                 MENSAGEM
                 ========================================= -->
            @if (!string.IsNullOrWhiteSpace(Mensagem))
            {
                <div class="mensagem-venda @(Mensagem.Contains("sucesso") ? "mensagem-sucesso" : "mensagem-erro")">

                    @Mensagem

                </div>
            }

        </div>


        <!-- =========================================
             LISTA DE VENDAS
             ========================================= -->

        <div class="lista-vendas">

            <div class="titulo-lista">

                <h2>
                    Vendas registradas
                </h2>

                <span>
                    @vendas.Count venda(s)
                </span>

            </div>


            @if (vendas == null)
            {
                <p>
                    Carregando vendas...
                </p>
            }

            else if (vendas.Count == 0)
            {
                <p>
                    Nenhuma venda registrada.
                </p>
            }

            else
            {
                <table>

                    <thead>

                        <tr>

                            <th>
                                Data
                            </th>

                            <th>
                                Produto
                            </th>

                            <th>
                                Quantidade
                            </th>

                            <th>
                                Vendedor
                            </th>

                            <th>
                                Forma de Pagamento
                            </th>

                            <th>
                                Valor
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var venda in vendas)
                        {
                            var itens = VendaDAO.ListarItens(venda.IdVenda);

                            @foreach (var item in itens)
                            {
                                var produto = produtos.FirstOrDefault(
                                    p => p.IdProduto == item.IdProduto
                                );

                                var vendedor = vendedores.FirstOrDefault(
                                    v => v.IdVendedor == venda.IdVendedor
                                );


                                <tr>

                                    <!-- DATA -->

                                    <td>
                                        @venda.DataVenda.ToString("dd/MM/yyyy")
                                    </td>


                                    <!-- PRODUTO -->

                                    <td>

                                        <div class="produto-tabela">

                                            <span class="produto-nome">

                                                @(produto?.NomeProduto
                                                    ?? "Produto")

                                            </span>

                                        </div>

                                    </td>


                                    <!-- QUANTIDADE -->

                                    <td>

                                        <span class="quantidade-tabela">

                                            @item.Quantidade

                                        </span>

                                    </td>


                                    <!-- VENDEDOR -->

                                    <td>

                                        @(vendedor?.Nome
                                            ?? "Vendedor")

                                    </td>


                                    <!-- PAGAMENTO -->

                                    <td>

                                        <span class="pagamento-tabela">

                                            @venda.FormaPagamento

                                        </span>

                                    </td>


                                    <!-- VALOR -->

                                    <td>

                                        <strong class="valor-tabela">

                                            R$ @item.Subtotal.ToString("F2")

                                        </strong>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>


@code {

    // =========================================
    // LISTAS
    // =========================================

    private List<Venda> vendas = new();

    private List<Produto> produtos = new();

    private List<Vendedor> vendedores = new();


    // =========================================
    // CAMPOS DO FORMULÁRIO
    // =========================================

    private int produtoSelecionado = 0;

    private int vendedorSelecionado = 0;

    private int quantidade = 1;

    private string formaPagamento = "PIX";

    private string Mensagem = "";


    // =========================================
    // PRODUTO SELECIONADO
    // =========================================

    private Produto? ProdutoSelecionado =>
        produtos.FirstOrDefault(
            p => p.IdProduto == produtoSelecionado
        );


    // =========================================
    // TOTAL DA VENDA
    // =========================================

    private decimal TotalVenda =>
        ProdutoSelecionado != null
            ? ProdutoSelecionado.Preco * quantidade
            : 0;


    // =========================================
    // INICIALIZAÇÃO
    // =========================================

    protected override void OnInitialized()
    {
        CarregarDados();
    }


    // =========================================
    // CARREGAR DADOS
    // =========================================

    private void CarregarDados()
    {
        vendas = VendaDAO.Listar();

        produtos = ProdutoDAO.Listar();

        vendedores = VendedorDAO.Listar();
    }


    // =========================================
    // REGISTRAR VENDA
    // =========================================

    private void RegistrarVenda()
    {
        Mensagem = "";


        // =====================================
        // VERIFICA PRODUTO
        // =====================================

        if (produtoSelecionado <= 0)
        {
            Mensagem = "Selecione um produto.";
            return;
        }


        // =====================================
        // VERIFICA VENDEDOR
        // =====================================

        if (vendedorSelecionado <= 0)
        {
            Mensagem = "Selecione um vendedor.";
            return;
        }


        // =====================================
        // VERIFICA QUANTIDADE
        // =====================================

        if (quantidade <= 0)
        {
            Mensagem = "Digite uma quantidade válida.";
            return;
        }


        // =====================================
        // VERIFICA SE O PRODUTO EXISTE
        // =====================================

        var produto = produtos.FirstOrDefault(
            p => p.IdProduto == produtoSelecionado
        );


        if (produto == null)
        {
            Mensagem = "Produto não encontrado.";
            return;
        }


        // =====================================
        // VERIFICA ESTOQUE
        // =====================================

        var estoqueAtual =
            EstoqueDAO.BuscarPorProduto(produtoSelecionado);


        if (estoqueAtual == null)
        {
            Mensagem =
                "Produto não possui estoque cadastrado.";

            return;
        }


        // =====================================
        // VERIFICA QUANTIDADE DISPONÍVEL
        // =====================================

        if (estoqueAtual.QuantidadeDisponivel < quantidade)
        {
            Mensagem =
                $"Estoque insuficiente. Disponível: {estoqueAtual.QuantidadeDisponivel}.";

            return;
        }


        try
        {

            // =================================
            // CRIA A VENDA
            // =================================

            var venda = new Venda
            {
                DataVenda = DateTime.Now,

                IdProduto = produtoSelecionado,

                IdVendedor = vendedorSelecionado,

                Quantidade = quantidade,

                ValorTotal = TotalVenda,

                FormaPagamento = formaPagamento
            };


            // =================================
            // SALVA A VENDA
            // =================================

            int idVenda =
                VendaDAO.InserirVenda(venda);


            // =================================
            // CRIA O ITEM DA VENDA
            // =================================

            var item = new ItemVenda
            {
                IdVenda = idVenda,

                IdProduto = produtoSelecionado,

                Quantidade = quantidade,

                PrecoUnitario = produto.Preco,

                Subtotal = TotalVenda
            };


            // =================================
            // SALVA O ITEM
            // =================================

            VendaDAO.InserirItem(item);


            // =================================
            // BAIXA O ESTOQUE
            // =================================

            bool estoqueBaixado =
                EstoqueDAO.BaixarEstoque(
                    produtoSelecionado,
                    quantidade
                );


            if (!estoqueBaixado)
            {
                Mensagem =
                    "Não foi possível atualizar o estoque.";

                return;
            }


            // =================================
            // SUCESSO
            // =================================

            Mensagem =
                "Venda registrada e estoque atualizado com sucesso!";


            // =================================
            // RECARREGA OS DADOS
            // =================================

            CarregarDados();


            // =================================
            // LIMPA O FORMULÁRIO
            // =================================

            produtoSelecionado = 0;

            vendedorSelecionado = 0;

            quantidade = 1;

            formaPagamento = "PIX";

        }

        catch (Exception ex)
        {
            Mensagem =
                "Erro ao registrar venda: " + ex.Message;
        }
    }

}
