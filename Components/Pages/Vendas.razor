@page "/Vendas"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models

@inject VendaDAO VendaDAO
@inject ProdutoDAO ProdutoDAO
@inject VendedorDAO VendedorDAO
@inject EstoqueDAO EstoqueDAO

<PageTitle>Vendas</PageTitle>

<div class="dashboard">

    <div class="sidebar">

        <img src="/Imagens/logo_.png"
             alt="Logo Saborall"
             class="logo" />

        <nav>
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas" class="ativo">Vendas</a>
            <a href="/Estoque">Estoque</a>
            <a href="/Produtos">Produtos</a>
            <a href="/Fornecedores">Fornecedores</a>
        </nav>

    </div>

    <div class="conteudo">

        <h1>Registro de Vendas</h1>

        <!-- FORMULÁRIO DE NOVA VENDA -->

        <div class="formulario-venda">

            <h2>Nova Venda</h2>

            <!-- PRODUTO -->
            <div>
                <label>Produto:</label>

                <select @bind="produtoSelecionado">

                    <option value="0">
                        Selecione o produto
                    </option>

                    @foreach (var produto in produtos)
                    {
                        <option value="@produto.IdProduto">
                            @produto.NomeProduto - R$ @produto.Preco.ToString("F2")
                        </option>
                    }

                </select>
            </div>

            <!-- QUANTIDADE -->
            <div>

                <label>Quantidade:</label>

                <input type="number"
                       min="1"
                       @bind="quantidade" />

            </div>

            <!-- VENDEDOR -->
            <div>

                <label>Vendedor:</label>

                <select @bind="vendedorSelecionado">

                    <option value="0">
                        Selecione o vendedor
                    </option>

                    @foreach (var vendedor in vendedores)
                    {
                        <option value="@vendedor.IdVendedor">
                            @vendedor.Nome
                        </option>
                    }

                </select>

            </div>

            <!-- FORMA DE PAGAMENTO -->
            <div>

                <label>Forma de pagamento:</label>

                <select @bind="formaPagamento">

                    <option value="PIX">PIX</option>
                    <option value="Cartão">Cartão</option>
                    <option value="Dinheiro">Dinheiro</option>

                </select>

            </div>

            <!-- TOTAL -->
            <div>

                <h3>
                    Total:
                    R$ @TotalVenda.ToString("F2")
                </h3>

            </div>

            <!-- BOTÃO -->
            <button @onclick="RegistrarVenda">
                Registrar venda
            </button>

            <!-- MENSAGEM -->
            @if (!string.IsNullOrWhiteSpace(Mensagem))
            {
                <p>@Mensagem</p>
            }

        </div>

        <!-- LISTA DE VENDAS -->
        @if (vendas == null)
        {
            <p>Carregando vendas...</p>
        }
        else if (vendas.Count == 0)
        {
            <p>Nenhuma venda registrada.</p>
        }
        else
        {
            <table>

                <thead>

                    <tr>
                        <th>Data</th>
                        <th>Produto</th>
                        <th>Quantidade</th>
                        <th>Vendedor</th>
                        <th>Forma de Pagamento</th>
                        <th>Valor</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var venda in vendas)
                    {
                        var itens = VendaDAO.ListarItens(venda.IdVenda);

                        @foreach (var item in itens)
                        {
                            var produto = produtos.FirstOrDefault(
                                p => p.IdProduto == item.IdProduto
                            );

                            var vendedor = vendedores.FirstOrDefault(
                                v => v.IdVendedor == venda.IdVendedor
                            );

                            <tr>

                                <td>
                                    @venda.DataVenda.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @(produto?.NomeProduto ?? "Produto")
                                </td>

                                <td>
                                    @item.Quantidade
                                </td>

                                <td>
                                    @(vendedor?.Nome ?? "Vendedor")
                                </td>

                                <td>
                                    @venda.FormaPagamento
                                </td>

                                <td>
                                    R$ @item.Subtotal.ToString("F2")
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        }

    </div>

</div>

@code {

    private List<Venda> vendas = new();
    private List<Produto> produtos = new();
    private List<Vendedor> vendedores = new();

    private int produtoSelecionado = 0;
    private int vendedorSelecionado = 0;
    private int quantidade = 1;

    private string formaPagamento = "PIX";

    private string Mensagem = "";

    private Produto? ProdutoSelecionado =>
        produtos.FirstOrDefault(
            p => p.IdProduto == produtoSelecionado
        );

    private decimal TotalVenda =>
        ProdutoSelecionado != null
            ? ProdutoSelecionado.Preco * quantidade
            : 0;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        vendas = VendaDAO.Listar();
        produtos = ProdutoDAO.Listar();
        vendedores = VendedorDAO.Listar();
    }

    private void RegistrarVenda()
    {
        Mensagem = "";

        // Verifica produto
        if (produtoSelecionado <= 0)
        {
            Mensagem = "Selecione um produto.";
            return;
        }

        // Verifica vendedor
        if (vendedorSelecionado <= 0)
        {
            Mensagem = "Selecione um vendedor.";
            return;
        }

        // Verifica quantidade
        if (quantidade <= 0)
        {
            Mensagem = "Digite uma quantidade válida.";
            return;
        }

        // Verifica se o produto realmente existe
        var produto = produtos.FirstOrDefault(
            p => p.IdProduto == produtoSelecionado
        );

        if (produto == null)
        {
            Mensagem = "Produto não encontrado.";
            return;
        }

        // Verifica estoque
        var estoqueAtual = EstoqueDAO.BuscarPorProduto(produtoSelecionado);

        if (estoqueAtual == null)
        {
            Mensagem = "Produto não possui estoque cadastrado.";
            return;
        }

        if (estoqueAtual.QuantidadeDisponivel < quantidade)
        {
            Mensagem =
                $"Estoque insuficiente. Disponível: {estoqueAtual.QuantidadeDisponivel}.";
            return;
        }

        try
        {
            // CRIA A VENDA
            var venda = new Venda
            {
                DataVenda = DateTime.Now,

                // CORREÇÃO PRINCIPAL
                IdProduto = produtoSelecionado,

                IdVendedor = vendedorSelecionado,

                // CORREÇÃO PRINCIPAL
                Quantidade = quantidade,

                ValorTotal = TotalVenda,

                FormaPagamento = formaPagamento
            };

            // Salva a venda e pega o ID gerado
            int idVenda = VendaDAO.InserirVenda(venda);

            // Cria o item da venda
            var item = new ItemVenda
            {
                IdVenda = idVenda,
                IdProduto = produtoSelecionado,
                Quantidade = quantidade,
                PrecoUnitario = produto.Preco,
                Subtotal = TotalVenda
            };

            // Salva o item
            VendaDAO.InserirItem(item);

            // Baixa o estoque
            bool estoqueBaixado = EstoqueDAO.BaixarEstoque(
                produtoSelecionado,
                quantidade
            );

            if (!estoqueBaixado)
            {
                Mensagem = "Não foi possível atualizar o estoque.";
                return;
            }

            // Sucesso
            Mensagem =
                "Venda registrada e estoque atualizado com sucesso!";

            // Recarrega os dados
            CarregarDados();

            // Limpa o formulário
            produtoSelecionado = 0;
            vendedorSelecionado = 0;
            quantidade = 1;
            formaPagamento = "PIX";
        }
        catch (Exception ex)
        {
            Mensagem =
                "Erro ao registrar venda: " + ex.Message;
        }
    }

}