@page "/Vendas"
@rendermode InteractiveServer

@using Saborall.DAO
@using Saborall.Models

@inject VendaDAO VendaDAO
@inject ProdutoDAO ProdutoDAO
@inject VendedorDAO VendedorDAO
@inject EstoqueDAO EstoqueDAO

<PageTitle>Vendas</PageTitle>

<div class="painel-principal">

    <!-- MENU LATERAL -->
    <div class="menu-lateral">
        <img src="/Imagens/logo_.png" class="imagem-logo" />
        <nav class="links-menu">
            <a href="/Pagina_inicial">Tela Inicial</a>
            <a href="/Vendas" class="link-ativo">Vendas</a>
            <a href="/Estoque">Estoque</a>
            <a href="/Produtos">Produtos</a>
            <a href="/Fornecedores">Fornecedores</a>
        </nav>
    </div>

    <!-- CONTEÚDO -->
    <div class="conteudo-pagina">
        <h1>Registro de Vendas</h1>

        <!-- FORMULÁRIO -->
        <div class="bloco-formulario">
            <h2>Nova Venda</h2>
            <br />

            <label>Produto:</label>
            <select @bind="produtoSelecionado" class="campo-entrada">
                <option value="0">Selecione...</option>
                @foreach (var p in produtos)
                {
                    <option value="@p.IdProduto">@p.NomeProduto - R$ @p.Preco</option>
                }
            </select>

            <label>Quantidade:</label>
            <input type="number" min="1" @bind="quantidade" class="campo-entrada" />

            <label>Vendedor:</label>
            <select @bind="vendedorSelecionado" class="campo-entrada">
                <option value="0">Selecione...</option>
                @foreach (var v in vendedores)
                {
                    <option value="@v.IdVendedor">@v.Nome</option>
                }
            </select>

            <label>Forma de Pagamento:</label>
            <select @bind="formaPagamento" class="campo-entrada">
                <option value="PIX">PIX</option>
                <option value="Cartão">Cartão</option>
                <option value="Dinheiro">Dinheiro</option>
            </select>

            <button @onclick="RegistrarVenda" class="botao-acao">Registrar Venda</button>

            @if (!string.IsNullOrEmpty(mensagem))
            {
                <p class="texto-mensagem">@mensagem</p>
            }
        </div>

        <!-- LISTA DE VENDAS -->
        <div class="bloco-tabela">
            <h2>Vendas Realizadas</h2>
            <br />

            <table class="tabela-simples">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Produto</th>
                        <th>Qtd</th>
                        <th>Pagamento</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in vendas)
                    {
                        var itens = VendaDAO.ListarItens(v.IdVenda);
                        var primeiroItem = itens.FirstOrDefault();
                        var prod = produtos.FirstOrDefault(p => p.IdProduto == (primeiroItem?.IdProduto ?? 0));
                        var vendedor = vendedores.FirstOrDefault(ve => ve.IdVendedor == v.IdVendedor);

                        <tr>
                            <td>@v.DataVenda.ToString("dd/MM/yyyy")</td>
                            <td>@(prod?.NomeProduto ?? "Produto")</td>
                            <td>@v.Quantidade</td>
                            <td>@v.FormaPagamento</td>
                            <td>R$ @v.ValorTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@code {
    private List<Venda> vendas = new();
    private List<Produto> produtos = new();
    private List<Vendedor> vendedores = new();

    private int produtoSelecionado = 0;
    private int vendedorSelecionado = 0;
    private int quantidade = 1;
    private string formaPagamento = "PIX";
    private string mensagem = "";

    protected override void OnInitialized()
    {
        CarregarTudo();
    }

    private void CarregarTudo()
    {
        vendas = VendaDAO.Listar();
        produtos = ProdutoDAO.Listar();
        vendedores = VendedorDAO.Listar();
    }

    private void RegistrarVenda()
    {
        mensagem = "";

        if (produtoSelecionado == 0 || vendedorSelecionado == 0)
        {
            mensagem = "Selecione o produto e o vendedor!";
            return;
        }

        if (quantidade <= 0)
        {
            mensagem = "A quantidade deve ser maior que zero!";
            return;
        }

        try
        {
            var prod = produtos.FirstOrDefault(p => p.IdProduto == produtoSelecionado);
            if (prod == null)
            {
                mensagem = "Produto não encontrado.";
                return;
            }

            var estoqueAtual = EstoqueDAO.BuscarPorProduto(produtoSelecionado);
            if (estoqueAtual == null)
            {
                mensagem = "Este produto não possui registro no estoque!";
                return;
            }

            if (estoqueAtual.QuantidadeDisponivel < quantidade)
            {
                mensagem = $"Estoque insuficiente! Disponível: {estoqueAtual.QuantidadeDisponivel}";
                return;
            }

            decimal total = prod.Preco * quantidade;

            var novaVenda = new Venda
            {
                DataVenda = DateTime.Now,
                IdVendedor = vendedorSelecionado,
                Quantidade = quantidade,
                ValorTotal = total,
                FormaPagamento = formaPagamento
            };

            int idVenda = VendaDAO.InserirVenda(novaVenda);

            var item = new ItemVenda
            {
                IdVenda = idVenda,
                IdProduto = produtoSelecionado,
                Quantidade = quantidade,
                PrecoUnitario = prod.Preco,
                Subtotal = total
            };

            VendaDAO.InserirItem(item);
            
            bool baixou = EstoqueDAO.BaixarEstoque(produtoSelecionado, quantidade);
            if (!baixou)
            {
                mensagem = "Erro ao baixar o estoque.";
                return;
            }

            mensagem = "Venda registrada com sucesso!";
            CarregarTudo();

            produtoSelecionado = 0;
            vendedorSelecionado = 0;
            quantidade = 1;
        }
        catch (Exception ex)
        {
            mensagem = "Erro ao registrar venda: " + ex.Message;
        }
    }
}